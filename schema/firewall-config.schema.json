{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/firewallguard/firewall-config.schema.json",
  "title": "FirewallGuard JSON Configuration",
  "type": "object",
  "required": ["rules"],
  "properties": {
    "firewall_name": {"type": "string"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "rule_id",
          "name",
          "action",
          "protocol",
          "source",
          "destination",
          "port",
          "enabled"
        ],
        "properties": {
          "rule_id": {"type": ["string", "integer"]},
          "name": {"type": "string", "minLength": 1},
          "action": {"enum": ["allow", "accept", "deny", "drop", "reject"]},
          "protocol": {"enum": ["any", "all", "tcp", "udp", "icmp", "icmpv6"]},
          "source": {"type": "string"},
          "destination": {"type": "string"},
          "port": {"type": ["string", "integer"]},
          "enabled": {"type": "boolean"},
          "description": {"type": "string"},
          "chain": {"type": "string"},
          "direction": {"enum": ["inbound", "outbound", "forward", "unknown"]},
          "in_interface": {"type": "string"},
          "out_interface": {"type": "string"},
          "connection_states": {"type": "string"}
        }
      }
    }
  }
}
